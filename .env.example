# Supabase Configuration
# Required for connecting to your Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application URL
# Used for redirects and links
VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# Email Configuration (SMTP)
# Required for sending emails (reset password, verification, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Duitku Configuration (Payment Gateway)
# This project is production-only (no sandbox runtime).
DUITKU_ENVIRONMENT=production

# Duitku Production Credentials
DUITKU_MERCHANT_CODE=your-production-merchant-code
DUITKU_API_KEY=your-production-api-key

# Duitku WebAPI base URL (Production)
# IMPORTANT: production WebAPI endpoint is https://passport.duitku.com/webapi
DUITKU_WEBAPI_BASE_URL=https://passport.duitku.com/webapi

# Callback and Return URLs
CALLBACK_URL=https://your-project.supabase.co/functions/v1/duitku-callback
RETURN_URL=https://your-domain.com/payment-callback
