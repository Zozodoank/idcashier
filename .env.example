# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=http://localhost:5173

# Optional frontend flags
VITE_APP_DEMO_DEV_WHITELIST=demo@idcashier.com,jho.j80@gmail.com
VITE_ENCRYPTION_KEY=replace-with-strong-random-key
VITE_NODE_ENV=development
VITE_APP_ENV=production

# ------------------------------------------------------------------------------
# Supabase / Edge Functions (set as Supabase secrets in production)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alias used by some legacy tools/scripts
SERVICE_ROLE_KEY=your-service-role-key

# URLs for auth redirects and payment return/callback flows
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Auth and scheduled jobs
JWT_SECRET=your-jwt-secret
CRONJOB_SECRET=your-random-cron-secret

# Demo data controls
DEMO_EMAIL=demo@idcashier.com
DEMO_SEED_EMPLOYEES=false

# ------------------------------------------------------------------------------
# Duitku (Payment Gateway)
# This project is production-first (default to production).
# ------------------------------------------------------------------------------
DUITKU_ENVIRONMENT=production
DUITKU_MERCHANT_CODE=your-production-merchant-code
DUITKU_API_KEY=your-production-api-key

# Backward compatibility alias used by some functions
DUITKU_MERCHANT_KEY=your-production-api-key

# Production WebAPI endpoint
DUITKU_WEBAPI_BASE_URL=https://passport.duitku.com/webapi

# Optional explicit callback/return URLs (functions have internal defaults)
CALLBACK_URL=https://your-project.supabase.co/functions/v1/duitku-callback
RETURN_URL=https://your-domain.com/payment-callback

# ------------------------------------------------------------------------------
# Node scripts and deployment helpers
# ------------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Optional template banner injection in vite.config.js (production builds)
TEMPLATE_BANNER_SCRIPT_URL=
TEMPLATE_REDIRECT_URL=

# Node runtime flag used by some scripts/build logic
NODE_ENV=production

# ------------------------------------------------------------------------------
# Legacy DB tools (only if you still use old MySQL scripts in /tools)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=idcashier

# ------------------------------------------------------------------------------
# Optional SMTP config (keep if you run SMTP-based flows/scripts)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
