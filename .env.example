# Supabase Configuration
# Required for connecting to your Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application URL
# Used for redirects and links
VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# Email Configuration (SMTP)
# Required for sending emails (reset password, verification, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Duitku Configuration (Payment Gateway)
# Switch between 'sandbox' and 'production'
DUITKU_ENVIRONMENT=sandbox

# Duitku Sandbox Credentials
DUITKU_SANDBOX_MERCHANT_CODE=your-sandbox-merchant-code
DUITKU_SANDBOX_API_KEY=your-sandbox-api-key
DUITKU_SANDBOX_BASE_URL=https://sandbox.duitku.com

# Duitku Production Credentials
DUITKU_PRODUCTION_MERCHANT_CODE=your-production-merchant-code
DUITKU_PRODUCTION_API_KEY=your-production-api-key
DUITKU_PRODUCTION_BASE_URL=https://passport.duitku.com
