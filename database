// Test environment variables
function testEnvironmentVariables() {
  console.log('🌍 Testing Environment Variables...\n');
  
  console.log('Expected environment variables:');
  console.log('- VITE_SUPABASE_URL:', process.env.VITE_SUPABASE_URL || 'Not set');
  console.log('- VITE_SUPABASE_ANON_KEY:', process.env.VITE_SUPABASE_ANON_KEY ? 'Set (hidden)' : 'Not set');
  
  console.log('\n✅ Environment variables check completed');
}

// Test file configurations
function testFileConfigurations() {
  console.log('📁 Testing File Configurations...\n');
  
  const fs = require('fs');
  
  // Check if .env files exist
  const envFiles = ['.env', '.env.duitku', '.env.local'];
  
  envFiles.forEach(file => {
    if (fs.existsSync(file)) {
      console.log(`✅ ${file} exists`);
      
      // Check if it contains Supabase variables
      const content = fs.readFileSync(file, 'utf8');
      if (content.includes('VITE_SUPABASE_URL') || content.includes('SUPABASE_URL')) {
        console.log(`  ✅ Contains Supabase URL configuration`);
      }
      if (content.includes('VITE_SUPABASE_ANON_KEY')) {
        console.log(`  ✅ Contains Supabase Anon Key configuration`);
      }
    } else {
      console.log(`❌ ${file} not found`);
    }
  });
  
  console.log('\n✅ File configuration check completed');
}

